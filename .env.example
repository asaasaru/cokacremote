# Network
MCP_HOST=0.0.0.0
MCP_PORT=3000
MCP_ENDPOINT=/mcp
MCP_PUBLIC_URL=https://mcp.example.com
MCP_TRUST_PROXY_HOPS=0

# Static bearer authentication. OAuth uses a separate operator approval key.
MCP_AUTH_TOKEN=replace-with-a-long-random-token
MCP_ALLOW_NO_AUTH=false
MCP_OAUTH_APPROVAL_KEY=

# Capability enforcement.
# Use bounded for the managed Pine/TVauto deployment. legacy preserves the old
# unrestricted tool behavior only for migration/backward compatibility.
MCP_CAPABILITY_MODE=bounded
MCP_CAPABILITY_PROFILE=pine-tvauto
MCP_CAPABILITY_PROJECT=vic-tvauto
# Generic coka-base host approvals are denied unless the target is under one of these absolute roots.
MCP_CAPABILITY_HOST_ROOTS=/Users/vicmac/DevMac/Biz/TVauto
# In bounded mode every exec_argv logical name must resolve through this operator-owned absolute map.
MCP_BOUNDED_EXECUTABLE_PATHS_JSON='{"git":"/usr/bin/git","node":"/usr/bin/node","npm":"/usr/bin/npm","python3":"/usr/bin/python3"}'

# Trusted backend-health reporters (AgentCore/RDC/TV Bridge) use a separate key.
# Leave unset to keep POST /internal/backend-health disabled.
MCP_BACKEND_HEALTH_KEY=

# Host execution defaults. In bounded mode these defaults do not bypass
# capability profiles or human-issued grants.
MCP_DEFAULT_CWD=/root
MCP_DEFAULT_SHELL=/bin/bash

# Operational limits.
MCP_MAX_REQUEST_BODY=8mb
MCP_MAX_OUTPUT_BYTES=1048576
MCP_MAX_RETAINED_PROCESS_OUTPUT_BYTES=4194304
MCP_PROCESS_RETENTION_MS=3600000
MCP_MAX_PROCESSES=128
MCP_MAX_FILE_CHUNK_BYTES=1048576
MCP_MAX_EDIT_FILE_BYTES=67108864


# Independent AgentCore outbound broker.
# Leave MCP_AGENTCORE_DEVICE_KEYS_JSON unset to disable these internal routes.
# Device keys are deployment secrets: never commit real values or store them in Drive.
MCP_AGENTCORE_DEVICE_KEYS_JSON=
MCP_AGENTCORE_DEVICE_STALE_MS=90000
MCP_AGENTCORE_JOB_TTL_MS=900000
